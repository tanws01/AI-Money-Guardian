# Terminal 3 testnet API key. Keep this server-side and never commit the real value.
T3N_API_KEY=

# Expected T3N agent identity. The server verifies the DID returned by authentication.
T3N_DID=did:t3n:08967108524dcf7faa0e5b59c69c8397eb997dc7

# Terminal 3 environment used by the SDK.
T3N_ENV=testnet

# Optional port.
PORT=3000
